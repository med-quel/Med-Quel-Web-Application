# Med-Quel Landing Page - Environment Variables

# App Configuration
VITE_APP_NAME=Med-Quel
VITE_APP_URL=https://www.medquel.com
VITE_PLAY_STORE_URL=https://play.google.com/store/apps/details?id=com.medquel

# Analytics (Optional - Add your Google Analytics ID)
# VITE_GA_ID=G-XXXXXXXXXX

# API Endpoints (If needed in future)
# VITE_API_URL=https://api.medquel.com

# Feature Flags (Optional)
# VITE_ENABLE_ANALYTICS=true
# VITE_ENABLE_NEWSLETTER=true
